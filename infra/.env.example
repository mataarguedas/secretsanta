# Copy to infra/.env and fill in the secrets. infra/.env is git-ignored.
# Docker Compose reads this file for variable interpolation; the backend loads it too.
#
# Comments are on their own lines on purpose: some .env parsers treat inline
# "# ..." as part of the value.
#
# Host-side dev URLs use 127.0.0.1 rather than localhost: on Windows, localhost
# resolves to ::1 first, and Docker's 127.0.0.1-only port bindings then hang.

# production | development | test
ENV=development

# Public origin of the app. Dev: http://localhost:5173 (always use the app through Vite).
APP_BASE_URL=http://localhost:5173
# Dev: localhost. Prod: the bare hostname Caddy gets a certificate for, e.g. santa.example.com
APP_DOMAIN=localhost

# ── PostgreSQL ───────────────────────────────────────
# Used by the postgres container. Any long random string works locally.
POSTGRES_PASSWORD=change-me
# Dev only: host port for the postgres container. Change it (e.g. 5433) if a native
# PostgreSQL already listens on 5432, and use the same port in DATABASE_URL.
POSTGRES_HOST_PORT=5432
# Dev (API runs on the host): postgresql+asyncpg://santa:<POSTGRES_PASSWORD>@127.0.0.1:5432/santa
# Prod (API runs in compose): postgresql+asyncpg://santa:<POSTGRES_PASSWORD>@postgres:5432/santa
DATABASE_URL=postgresql+asyncpg://santa:change-me@127.0.0.1:5432/santa

# ── Redis ────────────────────────────────────────────
# Dev: redis://127.0.0.1:6379/0   Prod: redis://redis:6379/0
REDIS_URL=redis://127.0.0.1:6379/0

# ── Auth ─────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
# Google Cloud Console › Credentials › OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Web Push (VAPID) ─────────────────────────────────
# Generate: uv run python -m app.scripts.gen_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Object storage (Cloudflare R2; MinIO in dev) ─────
# Prod: from the Cloudflare dashboard. Dev: leave empty.
R2_ACCOUNT_ID=
# Dev: these are also the MinIO root user/password (user ≥ 3 chars, password ≥ 8 chars).
R2_ACCESS_KEY_ID=santa-minio
R2_SECRET_ACCESS_KEY=change-me-please
R2_BUCKET=secret-santa
# Dev: http://127.0.0.1:9000 (the API runs on the host).
# Prod: leave empty; it is derived from R2_ACCOUNT_ID.
S3_ENDPOINT_URL=http://127.0.0.1:9000

# ── Observability ────────────────────────────────────
# Leave empty to disable Sentry.
SENTRY_DSN=

# ── Misc ─────────────────────────────────────────────
DEFAULT_TIMEZONE=America/Costa_Rica
