# Copy to infra/.env and fill in the secrets. infra/.env is git-ignored.
# Docker Compose reads this file for variable interpolation; the backend loads it too.
# Production: this becomes /opt/santa/.env on the server (README › "Production .env").
#
# Comments are on their own lines on purpose: some .env parsers treat inline
# "# ..." as part of the value.
#
# Host-side dev URLs use 127.0.0.1 rather than localhost: on Windows, localhost
# resolves to ::1 first, and Docker's 127.0.0.1-only port bindings then hang.

# production | development | test
ENV=development

# Public origin of the app. Dev: http://localhost:5173 (always use the app through Vite).
APP_BASE_URL=http://localhost:5173
# Dev: localhost. Prod: the bare hostname Caddy gets a certificate for, e.g. santa.example.com
APP_DOMAIN=localhost

# ── PostgreSQL ───────────────────────────────────────
# Used by the postgres container. Any long random string works locally.
POSTGRES_PASSWORD=change-me
# Dev only: host port for the postgres container. Change it (e.g. 5433) if a native
# PostgreSQL already listens on 5432, and use the same port in DATABASE_URL.
POSTGRES_HOST_PORT=5432
# Dev (API runs on the host): postgresql+asyncpg://santa:<POSTGRES_PASSWORD>@127.0.0.1:5432/santa
# Prod: ignored. docker-compose.yml builds it from POSTGRES_PASSWORD and the postgres service.
DATABASE_URL=postgresql+asyncpg://santa:change-me@127.0.0.1:5432/santa

# ── Redis ────────────────────────────────────────────
# Dev: redis://127.0.0.1:6379/0   Prod: ignored (docker-compose.yml uses redis://redis:6379/0)
REDIS_URL=redis://127.0.0.1:6379/0

# ── Auth ─────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
# Google Cloud Console › Credentials › OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Web Push (VAPID) ─────────────────────────────────
# Generate: uv run python -m app.scripts.gen_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Object storage (Cloudflare R2; MinIO in dev) ─────
# Prod: from the Cloudflare dashboard. Dev: leave empty.
R2_ACCOUNT_ID=
# Dev: these are also the MinIO root user/password (user ≥ 3 chars, password ≥ 8 chars).
R2_ACCESS_KEY_ID=santa-minio
R2_SECRET_ACCESS_KEY=change-me-please
R2_BUCKET=secret-santa
# Dev: http://127.0.0.1:9000 (the API runs on the host).
# Prod: leave empty; it is derived from R2_ACCOUNT_ID.
S3_ENDPOINT_URL=http://127.0.0.1:9000
# Optional: the storage address the browser uses, only for presigned photo URLs.
# Dev: http://localhost:9000 (the browser can't always use the API's address).
# Prod: leave empty; presigned URLs use the R2 endpoint.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# ── Observability ────────────────────────────────────
# Backend and worker. Leave empty to disable Sentry. (Frontend Sentry is a build-time
# setting: the GitHub Actions variable VITE_SENTRY_DSN.)
SENTRY_DSN=

# ── Misc ─────────────────────────────────────────────
DEFAULT_TIMEZONE=America/Costa_Rica

# ── Production stack (infra/docker-compose.yml) ─────
# Images: ghcr.io/<GHCR_OWNER>/santa-api and santa-web. The deploy workflow passes both
# for each deploy; these are the defaults for a manual `docker compose` on the server.
GHCR_OWNER=mataarguedas
IMAGE_TAG=latest
# Caddy. HSTS: one year in production; 0 for the local smoke test (so the browser doesn't
# pin https on localhost).
HSTS_MAX_AGE=31536000
# Extra CSP sources, space-separated. Local smoke test: CSP_IMG_EXTRA=http://localhost:9000.
# With frontend Sentry: CSP_CONNECT_EXTRA=https://<your-org-id>.ingest.sentry.io
CSP_IMG_EXTRA=
CSP_CONNECT_EXTRA=
